<Event @after>
  worldLoad = startLoop
  entityHurt = onHurt
  itemUse = onItemUse
  itemCompleteUse = onItemCompleteUse
  entityHitEntity = onHitEntity
  playerInteractWithBlock = onInteractBlock
  McxExtendsBy = ./EventBefore.mcx
</Event>
<script lang="ts">
import {
  EntityHitEntityAfterEvent,
  EntityHurtAfterEvent,
  ItemCompleteUseAfterEvent,
  ItemUseAfterEvent,
  Player,
  PlayerInteractWithBlockAfterEvent,
  system,
  VanillaEntityIdentifier,
  world,
} from "@minecraft/server";
import { processPlayerInTick } from "./core/tick";
import { dispatchGongFaUseEvent } from "./core/gongFaDispatch";
import { useDanYao } from "./core/danYaoRuntime";
import { isDanYaoItem } from "./utils/danyao";
import { placeZhenFa } from "./core/zhenFaRuntime";
import { processZhenFaInTick } from "./core/zhenFaRuntime";
import { getZhenFaIdFromItem } from "./utils/zhenfa";
import { showPutuanMenu } from "./core/putuanMenu";
import { AddonEntity, AddonItem } from "./config";
import { RUN_TICK } from "./config";
import { onPlayerStatusChange } from "./command/resolve";
import { getPositionInDirection } from "./utils/block";

export function startLoop() {
  onPlayerStatusChange((status, player) => {
    if (status == "inPuTuan") {
      showPutuanMenu(player);
    }
  })
  system.runInterval(() => {
    for (const player of world.getPlayers()) {
      // 使用 system.run 并发
      system.run(() => processPlayerInTick(player))
    }
    // 阵法推进是全局的（遍历所有维度），不随玩家重复
    system.run(() => processZhenFaInTick())
  }, RUN_TICK)
}
export function onHurt(event: EntityHurtAfterEvent) {
  if (event.hurtEntity.typeId == "minecraft:player") {
    dispatchGongFaUseEvent(event.hurtEntity as Player, "playerHurt", event);
  }
}
export function onItemUse(event: ItemUseAfterEvent) {
  const player = event.source;
  if (player.typeId != "minecraft:player") return;
  // 功法主动技能：仅以功法物品（洗得）为施法媒介
  if (event.itemStack?.typeId === AddonItem.GongFaXidei) {
    dispatchGongFaUseEvent(player as Player, "ItemUse", event);
  }
}
export function onItemCompleteUse(event: ItemCompleteUseAfterEvent) {
  const player = event.source;
  if (player.typeId != "minecraft:player") return;
  // 丹药：吃完（use_duration 走完）才生效，否则右键一开就触发了
  if (isDanYaoItem(event.itemStack)) {
    useDanYao(player as Player, event.itemStack);
  }
}
export function onHitEntity(event: EntityHitEntityAfterEvent) {
  if (event.damagingEntity.typeId == "minecraft:player") {
    dispatchGongFaUseEvent(event.damagingEntity as Player, "hitEntity", event);
  }
}
export function onInteractBlock(event: PlayerInteractWithBlockAfterEvent) {
  if (event.beforeItemStack?.typeId == AddonItem.PuTuan) {
    const loc = getPositionInDirection(event.block.location, event.blockFace);
    try {
      event.block.dimension.spawnEntity(AddonEntity.PuTuan as unknown as VanillaEntityIdentifier, loc)
    } catch (e) {
      console.error(`[SpawnPuTuan]: Cannot Spawn: Err: ${e}`)
    }
  }
  if (
    event.itemStack?.typeId === AddonItem.ZhenPan &&
    getZhenFaIdFromItem(event.itemStack)
  ) {
    placeZhenFa(event.player, event.itemStack, event.block, event.blockFace);
    return;
  }
  dispatchGongFaUseEvent(event.player, "interactBlock", event);
}
</script>
