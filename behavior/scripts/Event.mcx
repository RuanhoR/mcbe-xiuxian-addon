<Event @after>
  itemUse = onItemUse
  worldLoad = startLoop
  entityHitEntity = hit
  McxExtendsBy = ./EventBefore.mcx
</Event>
<script lang="ts">
import { EntityComponentTypes, EntityHitEntityAfterEvent, EquipmentSlot, ItemStack, world, type ItemUseAfterEvent, type VanillaEntityIdentifier } from "@minecraft/server";
import { AddonItem, SpiritStoneLevelMap } from "./config";
import { handleGongFaUse, handleGongFaXideiUse } from "./core/gongfa";
export function onItemUse(event: ItemUseAfterEvent) {
  function removeItem() {
    if (event.source.getGameMode() !== "Creative") if (event.itemStack.amount < 1) {
      event.source.getComponent(EntityComponentTypes.Equippable)?.setEquipment(EquipmentSlot.Mainhand)
    } else {
      event.source.getComponent(EntityComponentTypes.Equippable)?.setEquipment(EquipmentSlot.Mainhand, new ItemStack(AddonItem.PuTuan, event.itemStack.amount - 1))
    }
  }
  if (event.itemStack.typeId == AddonItem.PuTuan) {
    event.source.dimension.spawnEntity("xian:putuan" as unknown as VanillaEntityIdentifier, event.source.location);
    removeItem();
  } else if (event.itemStack?.typeId?.startsWith("xian:spirit_stone_level_")) {
    const spiritStoneLevel = SpiritStoneLevelMap[event.itemStack?.typeId as keyof typeof SpiritStoneLevelMap];
    if (!spiritStoneLevel) return;
    const status = event.source.getDynamicProperty("_bstatus");
    if (status !== "inPuTuan") {
      event.source.sendMessage({
        translate: "sapi.message.spiritstone.mustuseinputuan"
      })
    } else {

    }
  } else if (event.itemStack?.typeId == AddonItem.GongFa) {
    handleGongFaUse(event.source, event.itemStack);
  } else if (event.itemStack?.typeId == AddonItem.GongFaXidei) {
    handleGongFaXideiUse(event.source, event.itemStack);
  }
}
export function hit(event: EntityHitEntityAfterEvent) {
  if (event.hitEntity.typeId == "xian:putuan" && event.damagingEntity.typeId == "minecraft:player") {
    event.hitEntity.kill()
  }
}
export { startLoop } from "./core/loop"
</script>