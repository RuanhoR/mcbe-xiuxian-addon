<Component>
  <items>
    <item id="xian/raw-spirit_stone.json">RawSpiritStone</item>
    <item id="xian/spirit_stone_level1.json">SpiritStoneLevel1</item>
    <item id="xian/spirit_stone_level2.json">SpiritStoneLevel2</item>
    <item id="xian/spirit_stone_level3.json">SpiritStoneLevel3</item>
    <item id="xian/spirit_stone_level4.json">SpiritStoneLevel4</item>
    <item id="xian/spirit_stone_level0.json">SpiritStoneLevel0</item>
    <item id="xian/putuan.json">PuTuan</item>
    <item id="xian/zhenpan.json">ZhenPan</item>
    <item id="xian/sp_gongfa.json">GongFa</item>
    <item id="xian/gongfa-xidei.json">GongFaXidei</item>
    <item id="xian/sp_danyao.json">DanYao</item>
  </items>
</Component>
<script lang="ts">
import { ItemComponent } from "@mbler/mcx-component";
import { AddonItem } from "./config";
// ===== Define SpiritStoneItem ==== 
import RawSpiritStoneOreIcon from "./assets/raw_spirit_stone_ore.png"
import SpiritStoneLevel0Icon from "./assets/spirit_stone_level0.png"
import SpiritStoneLevel1Icon from "./assets/spirit_stone_level1.png"
import SpiritStoneLevel2Icon from "./assets/spirit_stone_level2.png"
import SpiritStoneLevel3Icon from "./assets/spirit_stone_level3.png"
import SpiritStoneLevel4Icon from "./assets/spirit_stone_level4.png"
import PuTuanIcon from "./assets/putuan-place.png";
import DanYaoIcon from "./assets/danyao.png";
import GongFaIcon from "./assets/gongfa.png"
function createItem(id: string, icon?: string, maxStack = 64) {
  const item = new ItemComponent({
    components: {},
    format: "1.21.0",
    id
  })
  item.setMaxStackSize(maxStack)
  if (icon) item.setIcon(icon)
  return item
}

export const RawSpiritStone = createItem(AddonItem.RawSpiritStoneOre, RawSpiritStoneOreIcon)
export const SpiritStoneLevel0 = createItem(AddonItem.SpiritStoneLevel0, SpiritStoneLevel0Icon)
export const SpiritStoneLevel1 = createItem(AddonItem.SpiritStoneLevel1, SpiritStoneLevel1Icon)
export const SpiritStoneLevel2 = createItem(AddonItem.SpiritStoneLevel2, SpiritStoneLevel2Icon)
export const SpiritStoneLevel3 = createItem(AddonItem.SpiritStoneLevel3, SpiritStoneLevel3Icon)
export const SpiritStoneLevel4 = createItem(AddonItem.SpiritStoneLevel4, SpiritStoneLevel4Icon)
// ==== Chore ====
export const PuTuan = createItem(AddonItem.PuTuan, PuTuanIcon)
export const ZhenPan = createItem(AddonItem.ZhenPan)
// ==== GongFa ====
export const GongFa = createItem(AddonItem.GongFa, GongFaIcon, 1)
export const GongFaXidei = createItem(AddonItem.GongFaXidei, undefined, 1)
// ==== DanYao ====
export const DanYao = createItem(AddonItem.DanYao, DanYaoIcon, 1)
DanYao.setFood({
  nutrition: 1,
  saturation_modifier: 1,
  can_always_eat: true,
})
DanYao.setUseAnimation("eat");
SpiritStoneLevel4.setGlint(true)
DanYao.setUseModifiers({
  use_duration: 2,
  movement_modifier: 1,
  start_sound: "eat"
})
</script>