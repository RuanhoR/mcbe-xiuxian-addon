<script lang="ts">
import { ItemComponent } from "@mbler/mcx-component";
import { AddonItem } from "../config";
// ===== Define SpiritStoneItem ==== 
import RawSpiritStoneOreIcon from "../assets/raw_spirit_stone_ore.png"
import SpiritStoneLevel0Icon from "../assets/spirit_stone_level0.png"
import SpiritStoneLevel1Icon from "../assets/spirit_stone_level1.png"
import SpiritStoneLevel2Icon from "../assets/spirit_stone_level2.png"
import SpiritStoneLevel3Icon from "../assets/spirit_stone_level3.png"
import SpiritStoneLevel4Icon from "../assets/spirit_stone_level4.png"
import PuTuanIcon from "../assets/putuan-place.png";
import DanYaoIcon from "../assets/danyao.png";
import GongFaIcon from "../assets/gongfa.png"
// ===== Define DanYao Icons (20色) ====
import DanYaoZhuhongIcon from "../assets/danyao_zhuhong.png"
import DanYaoOrangeIcon from "../assets/danyao_orange.png"
import DanYaoGoldenYellowIcon from "../assets/danyao_golden_yellow.png"
import DanYaoGreenIcon from "../assets/danyao_green.png"
import DanYaoCyanIcon from "../assets/danyao_cyan.png"
import DanYaoBlueIcon from "../assets/danyao_blue.png"
import DanYaoRoyalBlueIcon from "../assets/danyao_royal_blue.png"
import DanYaoPurpleIcon from "../assets/danyao_purple.png"
import DanYaoPinkIcon from "../assets/danyao_pink.png"
import DanYaoBrownIcon from "../assets/danyao_brown.png"
import DanYaoWhiteIcon from "../assets/danyao_white.png"
import DanYaoGrayIcon from "../assets/danyao_gray.png"
import DanYaoBlackIcon from "../assets/danyao_black.png"
import DanYaoLightCyanIcon from "../assets/danyao_light_cyan.png"
import DanYaoGrassGreenIcon from "../assets/danyao_grass_green.png"
import DanYaoPeachPinkIcon from "../assets/danyao_peach_pink.png"
import DanYaoOchreIcon from "../assets/danyao_ochre.png"
import DanYaoIndigoIcon from "../assets/danyao_indigo.png"
import DanYaoDarkTealIcon from "../assets/danyao_dark_teal.png"
import DanYaoSilverWhiteIcon from "../assets/danyao_silver_white.png"
function createItem(id: string, icon?: string, maxStack = 64) {
  const item = new ItemComponent({
    components: {},
    format: "1.21.0",
    id
  })
  item.setMaxStackSize(maxStack)
  if (icon) item.setIcon(icon)
  return item
}

export const RawSpiritStone = createItem(AddonItem.RawSpiritStoneOre, RawSpiritStoneOreIcon)
export const SpiritStoneLevel0 = createItem(AddonItem.SpiritStoneLevel0, SpiritStoneLevel0Icon)
export const SpiritStoneLevel1 = createItem(AddonItem.SpiritStoneLevel1, SpiritStoneLevel1Icon)
export const SpiritStoneLevel2 = createItem(AddonItem.SpiritStoneLevel2, SpiritStoneLevel2Icon)
export const SpiritStoneLevel3 = createItem(AddonItem.SpiritStoneLevel3, SpiritStoneLevel3Icon)
export const SpiritStoneLevel4 = createItem(AddonItem.SpiritStoneLevel4, SpiritStoneLevel4Icon)
// ==== Chore ====
export const PuTuan = createItem(AddonItem.PuTuan, PuTuanIcon)
export const ZhenPan = createItem(AddonItem.ZhenPan)
// ==== GongFa ====
export const GongFa = createItem(AddonItem.GongFa, GongFaIcon, 1)
export const GongFaXidei = createItem(AddonItem.GongFaXidei, undefined, 1)
// ==== DanYao 20色 ====
// menuCategory: 金黄丹为 "items"（创造栏可见），其余为 "none"（不在创造栏显示）
function createDanYao(id: AddonItem, icon: string, menuCategory: string) {
  const item = createItem(id, icon, 1)
  item.setMenuCategory(menuCategory)
  item.setFood({
    nutrition: 1,
    saturation_modifier: 1,
    can_always_eat: true,
  })
  item.setUseAnimation("eat")
  item.setUseModifiers({
    use_duration: 2,
    movement_modifier: 1,
    start_sound: "eat"
  })
  return item
}

export const DanYaoZhuhong = createDanYao(AddonItem.DanYaoZhuhong, DanYaoZhuhongIcon, "none")
export const DanYaoOrange = createDanYao(AddonItem.DanYaoOrange, DanYaoOrangeIcon, "none")
export const DanYaoGoldenYellow = createDanYao(AddonItem.DanYaoGoldenYellow, DanYaoGoldenYellowIcon, "items")
export const DanYaoGreen = createDanYao(AddonItem.DanYaoGreen, DanYaoGreenIcon, "none")
export const DanYaoCyan = createDanYao(AddonItem.DanYaoCyan, DanYaoCyanIcon, "none")
export const DanYaoBlue = createDanYao(AddonItem.DanYaoBlue, DanYaoBlueIcon, "none")
export const DanYaoRoyalBlue = createDanYao(AddonItem.DanYaoRoyalBlue, DanYaoRoyalBlueIcon, "none")
export const DanYaoPurple = createDanYao(AddonItem.DanYaoPurple, DanYaoPurpleIcon, "none")
export const DanYaoPink = createDanYao(AddonItem.DanYaoPink, DanYaoPinkIcon, "none")
export const DanYaoBrown = createDanYao(AddonItem.DanYaoBrown, DanYaoBrownIcon, "none")
export const DanYaoWhite = createDanYao(AddonItem.DanYaoWhite, DanYaoWhiteIcon, "none")
export const DanYaoGray = createDanYao(AddonItem.DanYaoGray, DanYaoGrayIcon, "none")
export const DanYaoBlack = createDanYao(AddonItem.DanYaoBlack, DanYaoBlackIcon, "none")
export const DanYaoLightCyan = createDanYao(AddonItem.DanYaoLightCyan, DanYaoLightCyanIcon, "none")
export const DanYaoGrassGreen = createDanYao(AddonItem.DanYaoGrassGreen, DanYaoGrassGreenIcon, "none")
export const DanYaoPeachPink = createDanYao(AddonItem.DanYaoPeachPink, DanYaoPeachPinkIcon, "none")
export const DanYaoOchre = createDanYao(AddonItem.DanYaoOchre, DanYaoOchreIcon, "none")
export const DanYaoIndigo = createDanYao(AddonItem.DanYaoIndigo, DanYaoIndigoIcon, "none")
export const DanYaoDarkTeal = createDanYao(AddonItem.DanYaoDarkTeal, DanYaoDarkTealIcon, "none")
export const DanYaoSilverWhite = createDanYao(AddonItem.DanYaoSilverWhite, DanYaoSilverWhiteIcon, "none")
</script>
