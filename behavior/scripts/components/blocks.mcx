<Component>
  <blocks>
    <block id="spirit_stone_ore.json">SpiritStoneOre</block>
  </blocks>
</Component>
<script lang="ts">
import { BlockComponent } from "@mbler/mcx-component";
import spiritStonePng from "../assets/spirit_stone_ore.png";

const SpiritStoneOre = new BlockComponent({
  format: "1.26.30",
  id: "xian:spirit_stone_ore"
});

SpiritStoneOre.setGeometry("minecraft:geometry.full_block");
SpiritStoneOre.setLoot("loot_tables/empty");

const materialInstances = {
  north: { texture: spiritStonePng },
  south: { texture: spiritStonePng },
  east: { texture: spiritStonePng },
  west: { texture: spiritStonePng },
  up: { texture: spiritStonePng },
  down: { texture: spiritStonePng }
};
SpiritStoneOre.setMaterialInstances(materialInstances);

SpiritStoneOre.setItemVisual({
  geometry: "minecraft:geometry.full_block",
  material_instances: {
    "*": { texture: spiritStonePng, render_method: "opaque" }
  }
});

SpiritStoneOre.setDestructibleByMining({ seconds_to_destroy: 6 });
SpiritStoneOre.setTags(["minecraft:is_pickaxe_item_destructible"]);

export { SpiritStoneOre };
</script>
